+/**
+ * Sushi patch: dRPC rejects every request without an `Authorization` JWT, and
+ * dependencies build their own viem clients without fetch options (Privy alone
+ * does so in ~9 places). Attaching the credential at viem's single HTTP choke
+ * point authenticates all of them, including clients added by future releases.
+ *
+ * An explicit `Authorization` header always wins, so callers that pass their
+ * own credential are untouched.
+ */
+const sushiDrpcJwt = (() => {
+    try {
+        return process.env.NEXT_PUBLIC_DRPC_JWT;
+    }
+    catch {
+        return undefined;
+    }
+})();
+function sushiDrpcAuthorization(url, headers) {
